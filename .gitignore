# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing (keep private!)
android/key.properties
*.jks
*.keystore

# Backend secrets — the Firebase service-account key is admin-level; server only.
server/api/config.php
server/api/fcm-service-account.json
**/firebase-adminsdk*.json

# Note: android/app/google-services.json is intentionally committed. It only
# holds the public Android app id + a restricted API key (already shipped inside
# every APK) and is required for the CI Android build.
