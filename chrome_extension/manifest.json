{
  "manifest_version": 3,
  "name": "TideView Helper",
  "version": "1.0.0",
  "description": "Starter Chrome extension: grabs the video ID from the YouTube page you're on so you can open it in TideView.",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TideView Helper"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "activeTab", "contextMenus"],

  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"]
}
