# Copy this file to .env and fill in your key. The .env file is ignored by git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
# Model: claude-opus-5 (default) or claude-fable-5-1 (most capable, roughly 2x the price)
JARVIS_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max  (medium keeps voice replies snappy)
JARVIS_EFFORT=medium
# Folder with your Markdown notes (absolute or relative to this folder)
NOTES_DIR=./notes
# Port for the local web app
PORT=3131
