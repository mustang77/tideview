# Copy this file to .env and fill in your key. The .env file is ignored by git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
# Model: claude-opus-5 (default) or claude-fable-5-1 (most capable, roughly 2x the price)
JARVIS_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max  (medium keeps voice replies snappy)
JARVIS_EFFORT=medium
# Folder with your Markdown notes (absolute or relative to this folder)
NOTES_DIR=./notes
# Port for the local web app
PORT=3131

# ---- Student access (for the WCA app) ----
# Create students.json next to this file (see students.example.json), or put the same JSON here.
# When a students list exists, every request needs a login and each student gets JARVIS_DAILY_LIMIT questions per day.
# JARVIS_STUDENTS={"students":[{"name":"Budi","email":"budi@example.com","pin":"4821"}]}
# Random secret so logins survive restarts: any long random text
JARVIS_AUTH_SECRET=
JARVIS_DAILY_LIMIT=40
