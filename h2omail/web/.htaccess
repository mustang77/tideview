# Always serve over HTTPS: Chrome marks a login page on plain http as
# "Not secure" and refuses to install the PWA.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Entry files must never be cached, or phones keep running an old build.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|flutter_service_worker\.js|flutter_bootstrap\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
