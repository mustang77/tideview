# Copy this file to  android/key.properties  and fill in YOUR values.
# NEVER commit key.properties or the .jks file — they are your app's identity.
# storeFile can be an absolute path (e.g. C:/Users/you/paramall-upload.jks).
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:/Users/you/paramall-upload.jks
